{
  "$schema": "https://v6.gh-proxy.com/https://github.com/jiang-zhexin/typebox/releases/latest/download/schema.json",
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      { "type": "local", "tag": "dns-local" },
      {
        "tag": "dns-cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com",
        "detour": "WARP",
        "domain_resolver": "dns-hosts"
      },
      {
        "tag": "dns-hosts",
        "type": "hosts",
        "predefined": {
          "cloudflare-dns.com": ["104.16.248.249", "104.16.249.249"]
        }
      }
    ]
  },
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "WARP",
      "address": ["172.16.0.2/32", "2606:4700:110:8dc5:553b:6747:e0b3:cbe4/128"],
      "private_key": "EMCsxRS1HQUiPfoEj/Agj/NA24FDeXcEl3WPyTKW4EM=",
      "peers": [
        {
          "address": "162.159.192.7",
          "port": 2408,
          "public_key": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
          "allowed_ips": ["0.0.0.0/0", "::/0"],
          "reserved": [226, 170, 176],
          "persistent_keepalive_interval": 30
        }
      ]
    }
  ],
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 10080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "resolve",
        "server": "dns-cloudflare",
        "strategy": "prefer_ipv6"
      }
    ],
    "final": "WARP",
    "default_domain_resolver": {
      "server": "dns-local",
      "strategy": "ipv4_only"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
