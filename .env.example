NODE_ENV=production

# 服务器监听配置
SERVER_LISTEN_HOST=0.0.0.0
SERVER_LISTEN_PORT=39001
SERVER_LOG_LEVEL=info

# Google Gemini API 配置
ENABLE_KEY_ROTATION=true
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
LOCAL_PROXY_BASE_URL=http://127.0.0.1:39001/gemini

GEMINI_API_KEYS=AIz...,AISz...

GEMINI_MODEL_NAME=gemini-3-flash-preview
MODEL_CONFIG_TEMPERATURE=1.0

MAX_API_CALL_ROUNDS=16
REQUEST_LIMIT_SECOND=20

CONTEXT_EXPIRATION_DAY=7
MAX_CONTEXT_LENGTH=8

GITHUB_ACCESS_TOKEN=github_pat...

# Telegram Bot API 配置
WEBHOOK_RECEIVE_URL=https://...
WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_TOKEN=

TELEGRAM_BOT_ID=100
TELEGRAM_BOT_USERNAME=xxx_bot
TELEGRAM_BOT_ADMIN_ID=123
ALLOWED_USAGE_GROUPS=132,100
