{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
  "name": "gemini-telegram-webhook",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "check:type": "tsc --noEmit",
    "check:lint": "eslint --fix",
    "check:all": "pnpm run check:type && pnpm run check:lint",
    "build-only": "vite build",
    "build:server": " pnpm run check:all && vite build",
    "build:docker": "docker buildx build --platform linux/amd64 -t gemini-telegram-webhook:latest .",
    "build:all": "pnpm run build:server && pnpm run build:docker",
    "dev": "tsx --env-file=.env.development --watch src/server.ts",
    "dev:docker": "docker run -it --rm --env-file .env.development -p 39001:39001 -v /data:/data gemini-telegram-webhook:latest",
    "start": "node --enable-source-maps --env-file=.env.development dist/index.js",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "push:github": "pnpm run format && git add . && git commit -m 'Update 2.0.0' && git push"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "better-sqlite3": "^12.5.0",
    "fastify": "^5.6.2",
    "mcp-local-rag": "link:../../../.local/share/pnpm/global/5/node_modules/mcp-local-rag",
    "tesseract.js": "^6.0.1",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4"
  }
}