{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
  "name": "gemini-telegram-webhook",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env.development --watch src/main.ts",
    "dev:docker": "docker run -it --rm --env-file .env.development -p 39001:39001 -v /data:/data gemini-telegram-webhook:latest",
    "build": "pnpm run check:all && vite build",
    "build:only": "vite build",
    "build:docker": "docker buildx build --platform linux/amd64 -t gemini-telegram-webhook:latest .",
    "start": "node --enable-source-maps --env-file=.env.development dist/index.js",
    "check:type": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:all": "pnpm run check:type && pnpm run check:format && pnpm run check:lint",
    "format": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fix:all": "pnpm run format && pnpm run fix:lint",
    "push:github": "pnpm run fix:all && git add . && git commit -m 'Update' && git push"
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "better-sqlite3": "^12.5.0",
    "fastify": "^5.6.2",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7"
  }
}
