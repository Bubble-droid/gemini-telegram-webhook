{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
  "name": "gemini-telegram-webhook",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "dev": "tsx --env-file=.env.development --watch src/main.ts",
    "dev:docker": "docker compose up -d --build",
    "test": "vitest run",
    "build": "vite build",
    "build:docker": "docker buildx build --platform linux/amd64 -t gemini-telegram-webhook:latest .",
    "start": "node --env-file=.env.development dist/index.mjs",
    "lint": "eslint --fix src/**/*.ts",
    "lint:check": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "check:all": "pnpm run typecheck && pnpm run lint:check && pnpm run format:check",
    "fix:all": "pnpm run format && pnpm run lint",
    "push:github": "git add . && git commit -m \"Update $(date +'%Y-%m-%d %H:%M:%S')\" && git push"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "fastify": "^5.7.4",
    "google-auth-library": "^10.5.0",
    "lowdb": "^7.0.1",
    "openai": "^6.22.0",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^24.10.13",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "grammy": "^1.40.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
