{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
  "name": "gemini-telegram-webhook",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env.development --watch src/main.ts",
    "dev:docker": "docker run -it --rm --env-file .env.development -p 39001:39001 -v /data:/data gemini-telegram-webhook:latest",
    "build": "pnpm run check:all && pnpm run build:only",
    "build:only": "vite build",
    "build:docker": "docker buildx build --platform linux/amd64 -t gemini-telegram-webhook:latest .",
    "start": "node --enable-source-maps --env-file=.env.development dist/index.js",
    "check:type": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:all": "pnpm run check:type && pnpm run check:format && pnpm run check:lint",
    "format": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fix:all": "pnpm run format && pnpm run fix:lint",
    "push:github": "pnpm run check:all && git add . && git commit -m 'Update' && git push"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "fastify": "^5.6.2",
    "lowdb": "^7.0.1",
    "tslog": "^4.10.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.10.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "grammy": "^1.39.2",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4"
  }
}
